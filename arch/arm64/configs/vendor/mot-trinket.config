CONFIG_MMI_DEVICE_DTBS=y
CONFIG_DRM_MSM_DSI_MOT_EXT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_ZLIB_COMPRESS is not set
CONFIG_USB_UAS=y

# Disable unused stock/QCOM drivers enabled in trinket-perf_defconfig
# CONFIG_TOUCHSCREEN_HIMAX_CHIPSET is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_FPR_FPC is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP is not set
# CONFIG_REGULATOR_PM8008 is not set
# CONFIG_BACKLIGHT_QCOM_SPMI_WLED is not set
# CONFIG_QCOM_SMCINVOKE is not set

CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_UTAGS=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_SENSORS_CLASS=m
CONFIG_QPNP_SMBCHARGER_MMI=m
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_EGISTEC_FPS_MMI=m
CONFIG_FINGERPRINT_FPC_TEE_MMI=m
